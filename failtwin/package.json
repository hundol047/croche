{
  "name": "failtwin",
  "version": "1.0.0",
  "private": true,
  "description": "FailTwin — AI가 당신의 실수를 먼저 예측합니다. SNU × Croche AI Hackathon 2026.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:logic": "tsc -p tsconfig.logic.json --noEmit",
    "test": "jest",
    "test:logic": "ts-node --project tsconfig.logic.json scripts/run-logic-tests.ts",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-router": "~3.5.0",
    "expo-status-bar": "~1.12.0",
    "expo-linking": "~6.3.0",
    "expo-constants": "~16.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10",
    "@react-native-async-storage/async-storage": "1.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.79",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.0",
    "react-test-renderer": "18.2.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3",
    "@types/react-test-renderer": "^18.0.7"
  }
}
