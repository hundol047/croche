{
  "name": "failtwin",
  "version": "1.0.0",
  "private": true,
  "description": "FailTwin — AI가 당신의 실수를 먼저 예측합니다. SNU × Croche AI Hackathon 2026.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:logic": "tsc -p verify/tsconfig.verify.json --noEmit",
    "test": "jest",
    "test:logic": "node scripts/run-logic-tests.js",
    "verify:offline": "bash scripts/verify-logic.sh",
    "demo:loop": "tsc -p verify/tsconfig.verify.json && node -r ./verify/preload.js .verify-out/verify/demo-loop.js",
    "lint": "eslint . --ext .ts,.tsx",
    "build:web": "expo export --platform web",
    "test:web": "playwright test"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.0",
    "expo-linking": "~6.3.0",
    "expo-router": "~3.5.0",
    "expo-status-bar": "~1.12.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@playwright/test": "1.58.2",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.79",
    "@types/react-test-renderer": "18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~7.1.2",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.0",
    "react-test-renderer": "18.2.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3"
  },
  "overrides": {
    "@types/react": "~18.2.79",
    "react-test-renderer": "18.2.0"
  },
  "resolutions": {
    "@types/react": "~18.2.79"
  }
}
