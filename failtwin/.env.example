# Public client configuration. Never put provider keys in this file.
EXPO_PUBLIC_CROCHE_MODE=mock

# Full URL of YOUR authenticated FailTwin server proxy (not a guessed Croche API).
# Requires the server contract and official adapter described in docs/AI_INTEGRATION.md.
# HTTPS is required except for loopback development. No credentials/query in the URL.
EXPO_PUBLIC_CROCHE_PROXY_URL=

# Model identifiers confirmed by your official workspace; server must allowlist them.
EXPO_PUBLIC_CROCHE_MODEL_CHEAP=
EXPO_PUBLIC_CROCHE_MODEL_QUALITY=
# CROCHE_API_KEY is server-only. Do not set it in the Expo project.
