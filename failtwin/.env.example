# FailTwin environment variables
# Copy to .env (gitignored). Never commit real keys.

# Croche service mode: "mock" (default, no network/SDK needed) or "real"
EXPO_PUBLIC_CROCHE_MODE=mock

# --- Only needed when EXPO_PUBLIC_CROCHE_MODE=real ---
# Croche API / SDK configuration (fill in from your Croche workspace).
# These are read inside src/services/croche/client.ts.
EXPO_PUBLIC_CROCHE_BASE_URL=
# Secret key: prefer a backend proxy. If you must use client-side for a demo,
# do NOT commit it. (A non-EXPO_PUBLIC name keeps it out of the client bundle
# when wired through a server.)
CROCHE_API_KEY=

# Model tiers (optional overrides; defaults live in src/services/ai/modelPolicy.ts)
EXPO_PUBLIC_CROCHE_MODEL_CHEAP=
EXPO_PUBLIC_CROCHE_MODEL_QUALITY=
